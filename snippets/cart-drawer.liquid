<div class="drawer" data-drawer aria-hidden="true">
  <div class="drawer-overlay" data-drawer-close></div>
  <aside class="drawer-panel" role="dialog" aria-modal="true" aria-label="{{ 'cart.title' | t }}">
    <header class="drawer-head"><h2>{{ 'cart.title' | t }}</h2><button type="button" class="icon-btn" data-drawer-close aria-label="{{ 'general.close' | t }}">{% render 'icon', name: 'close' %}</button></header>
    <div class="drawer-bar" data-drawer-bar></div>
    <div class="drawer-body" data-drawer-body></div>
    <footer class="drawer-foot" data-drawer-foot></footer>
  </aside>
</div>
