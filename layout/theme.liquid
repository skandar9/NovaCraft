<!doctype html>
{%- liquid
  assign lang = request.locale.iso_code | split: '-' | first
  assign rtl_langs = 'ar,fa,ur,he' | split: ','
  assign is_rtl = false
  if rtl_langs contains lang
    assign is_rtl = true
  endif
  assign ar_h = settings.arabic_heading | default: 'Cairo'
  assign ar_b = settings.arabic_body | default: 'Tajawal'
  case settings.spacing
    when 'small'
      assign space = '40px'
    when 'large'
      assign space = '110px'
    else
      assign space = '72px'
  endcase
-%}
<html lang="{{ request.locale.iso_code }}" dir="{% if is_rtl %}rtl{% else %}ltr{% endif %}" class="{% if settings.reveal %}anim{% endif %}">
<head>
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="theme-color" content="{{ settings.color_accent }}">
  <link rel="canonical" href="{{ canonical_url }}">
  {%- if settings.favicon != blank -%}<link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">{%- endif -%}
  <title>{{ page_title }}{% if current_page != 1 %} – {{ current_page }}{% endif %}{% unless page_title contains shop.name %} – {{ shop.name }}{% endunless %}</title>
  {%- if page_description -%}<meta name="description" content="{{ page_description | escape }}">{%- endif -%}
  <meta property="og:site_name" content="{{ shop.name }}">
  <meta property="og:title" content="{{ page_title | escape }}">
  <meta property="og:url" content="{{ canonical_url }}">
  <meta name="twitter:card" content="summary_large_image">
  {%- if page_image -%}<meta property="og:image" content="https:{{ page_image | image_url: width: 1200 }}">{%- endif -%}

  {{ content_for_header }}

  {%- if is_rtl -%}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    {%- if ar_h == ar_b -%}
      <link href="https://fonts.googleapis.com/css2?family={{ ar_h | replace: ' ', '+' }}:wght@400;500;700&display=swap" rel="stylesheet">
    {%- else -%}
      <link href="https://fonts.googleapis.com/css2?family={{ ar_h | replace: ' ', '+' }}:wght@400;700&family={{ ar_b | replace: ' ', '+' }}:wght@400;500;700&display=swap" rel="stylesheet">
    {%- endif -%}
  {%- else -%}
    <style>
      {{ settings.font_heading | font_face: font_display: 'swap' }}
      {{ settings.font_body | font_face: font_display: 'swap' }}
    </style>
  {%- endif -%}
  <style>
    :root{
      --bg:{{ settings.color_bg | default: '#f6f7f8' }};--text:{{ settings.color_text | default: '#1e2528' }};
      --accent:{{ settings.color_accent | default: '#0b8a82' }};--accent-text:{{ settings.color_accent_text | default: '#ffffff' }};
      --aqua:{{ settings.color_aqua | default: '#35d0c0' }};--soft:{{ settings.color_soft | default: '#e8ecee' }};--border:{{ settings.color_border | default: '#d5dbde' }};
      --deep:{{ settings.color_deep | default: '#1e2528' }};--sale:{{ settings.color_sale | default: '#d6336c' }};
      --page-width:{{ settings.page_width | default: 1360 }}px;--radius:{{ settings.radius | default: 12 }}px;
      --btn-radius:{% if settings.btn_pill %}999px{% else %}{{ settings.radius | default: 12 }}px{% endif %};
      --space:{{ space }};--base:{{ settings.base_size | default: 16 }}px;--h-scale:{{ settings.heading_scale | default: 100 | divided_by: 100.0 }};
      --h-transform:{% if settings.heading_upper %}uppercase{% else %}none{% endif %};
      --card-ratio:{{ settings.card_ratio | default: '4/5' }};--cols-d:{{ settings.cols_desktop | default: 4 }};--cols-m:{{ settings.cols_mobile | default: 2 }};
      {%- if is_rtl -%}
      --font-heading:'{{ ar_h }}',sans-serif;--font-body:'{{ ar_b }}',sans-serif;
      {%- else -%}
      --font-heading:{{ settings.font_heading.family | default: 'system-ui' }},{{ settings.font_heading.fallback_families | default: 'sans-serif' }};
      --font-body:{{ settings.font_body.family | default: 'system-ui' }},{{ settings.font_body.fallback_families | default: 'sans-serif' }};
      {%- endif -%}
    }
  </style>
  {{ 'theme.css' | asset_url | stylesheet_tag }}
  <script>
    document.documentElement.classList.add('js');
    window.theme = {
      cartType: {{ settings.cart_type | json }},
      freeShip: {{ settings.free_shipping_threshold | default: 0 | times: 100 }},
      predictive: {{ settings.predictive_search | json }},
      searchLimit: {{ settings.search_limit | default: 4 }},
      suggestUrl: {{ routes.predictive_search_url | append: '.json' | json }},
      root: {{ routes.root_url | json }},
      i18n: {
        empty: {{ 'cart.empty' | t | json }}, remove: {{ 'cart.remove' | t | json }}, subtotal: {{ 'cart.subtotal' | t | json }},
        checkout: {{ 'cart.checkout' | t | json }}, view: {{ 'cart.view' | t | json }}, cont: {{ 'cart.continue' | t | json }},
        taxes: {{ 'cart.taxes' | t | json }}, saved: {{ 'cart.you_save' | t | json }}, freeLeft: {{ 'cart.free_left' | t: amount: '__A__' | json }},
        freeDone: {{ 'cart.free_done' | t | json }}, products: {{ 'search.products' | t | json }}, collections: {{ 'search.collections' | t | json }},
        articles: {{ 'search.articles' | t | json }}, viewAll: {{ 'search.view_all' | t | json }}, copied: {{ 'general.copied' | t | json }},
        add: {{ 'product.add_to_cart' | t | json }}, soldOut: {{ 'general.sold_out' | t | json }}, low: {{ 'product.only_left' | t: count: '__N__' | json }},
        inStock: {{ 'product.in_stock' | t | json }}, noWishlist: {{ 'wishlist.empty' | t | json }}, off: {{ 'general.off' | t | json }},
        days: {{ 'general.days' | t | json }}, hours: {{ 'general.hours' | t | json }}, mins: {{ 'general.mins' | t | json }}, secs: {{ 'general.secs' | t | json }}
      }
    };
  </script>
  <script src="{{ 'theme.js' | asset_url }}" defer></script>
</head>
<body class="template-{{ request.page_type | handle }}{% if settings.sticky_header %} has-sticky{% endif %}">
  <a class="skip" href="#main">{{ 'general.skip' | t }}</a>
  {% section 'announcement-bar' %}
  {% section 'header' %}
  <main id="main">{{ content_for_layout }}</main>
  {% section 'footer' %}
  {% render 'cart-drawer' %}
  {% render 'search-overlay' %}
</body>
</html>
