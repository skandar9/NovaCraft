<div class="container section narrow center">
  <h1>{{ shop.name }}</h1>
  {%- if shop.password_message != blank -%}<div class="rte">{{ shop.password_message }}</div>{%- endif -%}
  {%- form 'storefront_password', class: 'form' -%}
    {{ form.errors | default_errors }}
    <label for="Password">{{ 'customer.password' | t }}</label>
    <input type="password" name="password" id="Password" required>
    <button class="btn" type="submit">{{ 'general.enter' | t }}</button>
  {%- endform -%}
</div>
