<section class="container section narrow">
  <header class="page-head"><h1>{{ 'customer.reset_title' | t }}</h1></header>
  {%- form 'reset_customer_password', class: 'form' -%}
    {{ form.errors | default_errors }}
    <label for="rp1">{{ 'customer.password' | t }}</label>
    <input id="rp1" type="password" name="customer[password]" autocomplete="new-password" required>
    <label for="rp2">{{ 'customer.confirm_password' | t }}</label>
    <input id="rp2" type="password" name="customer[password_confirmation]" autocomplete="new-password" required>
    <button class="btn" type="submit">{{ 'customer.submit' | t }}</button>
  {%- endform -%}
</section>
{% schema %}
{"name":"Reset password"}
{% endschema %}
