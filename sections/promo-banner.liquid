<section class="section promo-wrap bg-{{ section.settings.bg }}">
  <div class="container promo">
    <div class="promo-text">
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
      {%- if section.settings.ends_at != blank -%}<div class="countdown" data-countdown="{{ section.settings.ends_at }}"></div>{%- endif -%}
      <div class="promo-actions">
        {%- if section.settings.code != blank -%}<button type="button" class="code" data-copy="{{ section.settings.code }}"><strong>{{ section.settings.code }}</strong><small>{{ 'general.copy' | t }}</small></button>{%- endif -%}
        {%- if section.settings.button_label != blank -%}<a class="btn btn-aqua" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label }}</a>{%- endif -%}
      </div>
    </div>
    <div class="promo-media">
      {%- if section.settings.image != blank -%}{{ section.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', alt: section.settings.image.alt }}{%- else -%}{% render 'art', v: section.settings.art %}{%- endif -%}
    </div>
  </div>
</section>
{% schema %}
{"name":"Offer / discount banner","settings":[
  {"type":"select","id":"bg","label":"Style","default":"dark","options":[{"value":"dark","label":"Dark"},{"value":"accent","label":"Turquoise"},{"value":"soft","label":"Gray"}]},
  {"type":"text","id":"heading","label":"Heading","default":"Weekend sale: 20% off"},
  {"type":"textarea","id":"text","label":"Text","default":"Use the code at checkout. Automatic discounts also show in your cart."},
  {"type":"text","id":"code","label":"Discount code (copy button)","default":"CRAFT20","info":"Create the same code in Admin > Discounts"},
  {"type":"text","id":"ends_at","label":"Offer ends (YYYY-MM-DD HH:MM)","info":"Shows a live countdown"},
  {"type":"text","id":"button_label","label":"Button label","default":"Shop the sale"},{"type":"url","id":"button_link","label":"Button link"},
  {"type":"image_picker","id":"image","label":"Photo (optional)"},
  {"type":"select","id":"art","label":"Illustration if no photo","default":"3","options":[{"value":"1","label":"Mug"},{"value":"2","label":"Vase"},{"value":"3","label":"Candle"},{"value":"4","label":"Woven textile"},{"value":"5","label":"Basket"}]}],
 "presets":[{"name":"Offer / discount banner"}]}
{% endschema %}
