<section class="section container bg-{{ section.settings.bg }}" data-recent="{{ product.handle }}" hidden>
  <div class="section-head"><h2>{{ section.settings.heading }}</h2></div>
  <div class="pgrid" data-recent-list></div>
</section>
{% schema %}
{"name": "Recently viewed", "settings": [{"type": "text", "id": "heading", "label": "Heading", "default": "Recently viewed"}, {"type": "select", "id": "bg", "label": "Background", "default": "default", "options": [{"value": "default", "label": "Default"}, {"value": "soft", "label": "Soft gray"}, {"value": "dark", "label": "Dark"}, {"value": "accent", "label": "Turquoise"}]}], "presets": [{"name": "Recently viewed"}]}
{% endschema %}
