{%- paginate collection.products by section.settings.per_page -%}
{%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}
<section class="container section">
  {% render 'breadcrumbs' %}
  {%- if section.settings.show_banner and collection.image -%}
    <div class="coll-banner">{{ collection.image | image_url: width: 1800 | image_tag: loading: 'eager', alt: collection.title }}<div class="coll-banner-text"><h1>{{ collection.title }}</h1></div></div>
  {%- else -%}
    <header class="page-head"><h1>{{ collection.title }}</h1></header>
  {%- endif -%}
  {%- if collection.description != blank -%}<div class="rte coll-desc">{{ collection.description }}</div>{%- endif -%}

  <div class="toolbar">
    {%- if collection.filters.size > 0 -%}<button type="button" class="btn btn-ghost filter-open" data-filters-open>{% render 'icon', name: 'filter', size: 18 %} {{ 'collection.filters' | t }}</button>{%- endif -%}
    <p class="muted">{{ paginate.items }} {{ 'collection.products' | t }}</p>
    <div class="toolbar-right">
      <div class="layout-toggle" role="group" aria-label="Layout"><button type="button" data-cols="2">▦</button><button type="button" data-cols="3">▥</button><button type="button" data-cols="4">▤</button></div>
      <label for="sort" class="sr">{{ 'collection.sort' | t }}</label>
      <select id="sort" name="sort_by" form="filters" data-auto-submit>{%- for option in collection.sort_options -%}<option value="{{ option.value }}" {% if option.value == sort_by %}selected{% endif %}>{{ option.name }}</option>{%- endfor -%}</select>
    </div>
  </div>
  {% render 'active-filters', filters: collection.filters, base_url: collection.url %}

  <div class="coll-layout{% if collection.filters.size == 0 %} no-filters{% endif %}">
    {%- if collection.filters.size > 0 -%}
      <aside class="filters-wrap" data-filters-wrap>{% render 'filters', filters: collection.filters, base_url: collection.url %}</aside>
      <div class="filters-backdrop" data-filters-close></div>
    {%- else -%}<form id="filters" method="get"></form>{%- endif -%}
    <div class="coll-results">
      {%- if collection.products.size == 0 -%}<p class="center">{{ 'collection.empty' | t }}</p><p class="center"><a class="btn btn-ghost" href="{{ collection.url }}">{{ 'collection.clear' | t }}</a></p>
      {%- else -%}<div class="pgrid" data-pgrid>{%- for product in collection.products -%}{% render 'product-card', product: product %}{%- endfor -%}</div>{%- endif -%}
      {% render 'pagination', paginate: paginate %}
    </div>
  </div>
</section>
{%- endpaginate -%}
{% schema %}
{"name":"Collection","settings":[
  {"type":"range","id":"per_page","min":4,"max":48,"step":4,"label":"Products per page","default":12},
  {"type":"checkbox","id":"show_banner","label":"Show collection image as banner","default":true}]}
{% endschema %}
