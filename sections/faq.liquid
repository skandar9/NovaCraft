<section class="section container narrow bg-{{ section.settings.bg }}">
  <div class="section-head"><h2>{{ section.settings.heading }}</h2></div>
  <div class="faq">{%- for block in section.blocks -%}<details {{ block.shopify_attributes }}><summary>{{ block.settings.question }}</summary><div class="rte"><p>{{ block.settings.answer }}</p></div></details>{%- endfor -%}</div>
</section>
{% schema %}
{"name": "FAQ", "settings": [{"type": "text", "id": "heading", "label": "Heading", "default": "Questions, answered"}, {"type": "select", "id": "bg", "label": "Background", "default": "default", "options": [{"value": "default", "label": "Default"}, {"value": "soft", "label": "Soft gray"}, {"value": "dark", "label": "Dark"}, {"value": "accent", "label": "Turquoise"}]}], "blocks": [{"type": "item", "name": "Question", "settings": [{"type": "text", "id": "question", "label": "Question", "default": "Question?"}, {"type": "textarea", "id": "answer", "label": "Answer", "default": "Answer."}]}], "presets": [{"name": "FAQ", "blocks": [{"type": "item", "settings": {"question": "How long does shipping take?", "answer": "Orders ship within 2 business days. Delivery usually takes 2 to 7 days depending on your location."}}, {"type": "item", "settings": {"question": "Can I send an order as a gift?", "answer": "Yes. Add gift wrapping and a note in your cart."}}, {"type": "item", "settings": {"question": "Are the pieces really handmade?", "answer": "Yes. Small variations are part of what makes each piece unique."}}, {"type": "item", "settings": {"question": "What is your return policy?", "answer": "If something arrives damaged or isn't right, contact us within 14 days."}}]}]}
{% endschema %}
